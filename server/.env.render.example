NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/slopsound?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
SESSION_SECRET=long-random-string
CORS_ORIGIN=https://slopsound.onrender.com,tauri://localhost,http://tauri.localhost,http://localhost:1420
COOKIE_SAMESITE=none
OAUTH_REDIRECT_TO=https://slopsound.onrender.com
UPDATE_MANIFEST_URL=https://github.com/emin1923nzz/slopsound/releases/latest/download/latest.json
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:43127/callback
GOOGLE_WEB_REDIRECT_URI=https://slopsound.onrender.com/auth/google/return
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
RTC_STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.example.com:3478
TURN_USERNAME=your-turn-user
TURN_CREDENTIAL=your-turn-password
GROQ_API_KEY=optional-global-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
